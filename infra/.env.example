# ChakraMCP on Docker Compose: copy to .env next to docker-compose.prod.yml
# and fill it in. Walkthrough: docs/self-hosting/compose.md.
#
# Generate secrets with: openssl rand -hex 32
# Values are literal; wrap one in single quotes if it contains spaces, #,
# quotes or $ (e.g. the JSON in PROBE_TARGETS).

# ─── Required ─────────────────────────────────────────────────────────
# Public hostnames. Point their DNS at this host before the first start:
# Caddy gets Let's Encrypt certificates for them on ports 80/443.
APP_DOMAIN=app.example.com
RELAY_DOMAIN=relay.example.com
APP_PUBLIC_URL=https://app.example.com
RELAY_PUBLIC_URL=https://relay.example.com

POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me

# ─── Image ────────────────────────────────────────────────────────────
# Defaults to ghcr.io/delta-s-labs/chakramcp-server:latest, the newest
# release. Pin one (e.g. :0.3.0), or use :edge to follow main.
# CHAKRAMCP_IMAGE=ghcr.io/delta-s-labs/chakramcp-server:0.3.0

# ─── Accounts ─────────────────────────────────────────────────────────
# Create the first admin from the host once the stack is up:
#   docker compose -f docker-compose.prod.yml exec relay \
#     chakramcp-server users add you@example.com --name "Your Name" --admin
# Public sign-up is closed: add people with `users add`, or open it while
# your team signs up.
# SIGNUP_ENABLED=false

# ─── Credits and limits (optional) ───────────────────────────────────
# Credits are off: nobody is refused for running out. Turn them on to give
# each account a monthly allowance; manage them with
# `chakramcp-server credits`. Amounts are in milli-credits (1 credit =
# 1,000): the defaults are 100 credits a month and 0.1 credit a call.
# CREDITS_ENABLED=false
# CREDITS_DEFAULT_MONTHLY_FREE_MC=100000
# CREDITS_COST_PER_INVOCATION_MC=100
# Calls per minute per account, and whether over-limit calls are refused
# (429) or only logged.
# LIMITS_DEFAULT_RATE_PER_MIN=60
# LIMITS_ENFORCE=true
# SYSTEM_ONE_CHECKS=false
# TYPESAFE_AI_KEY=
# TYPESAFE_AI_MODEL=jev-latest

# ─── chakramcp.com only ──────────────────────────────────────────────
# These configure the hosted service at chakramcp.com. Leave them unset:
#   HOSTING_MODE          managed there; self_hosted (the default) elsewhere
#   ADMIN_EMAIL           with managed, signing up with it grants admin
#   UPSERT_SHARED_SECRET  the web UI's Google/GitHub sign-in callback
#   FRONTEND_PUBLIC_URL   where the web UI lives; unset means APP_PUBLIC_URL,
#                         where this server serves its own sign-in pages

# ─── Logging ──────────────────────────────────────────────────────────
# journald (the default) needs a systemd Linux host and is what the
# observability stack reads. On Docker Desktop use json-file; the
# observability stack then can't run.
# LOG_DRIVER=journald

# ─── Observability (infra/observability/, optional) ──────────────────
# Started with observability/scripts/deploy.sh; guide:
# docs/self-hosting/observability.md.
# Grafana's public hostname. Leave it unset without the stack: Caddy then
# serves that site as localhost and requests no certificate for it.
# GRAFANA_DOMAIN=grafana.example.com
GRAFANA_ADMIN_PASSWORD=change-me
# The collector's read-only Postgres role.
PG_MONITOR_PASSWORD=change-me

# Who may sign in through a provider: a JMESPath expression over the
# provider's user info that yields a Grafana role (e.g. 'GrafanaAdmin'), or
# nothing to refuse. Empty refuses everyone. Examples:
#   GitHub (its /user response):  "login == 'your-login' && 'GrafanaAdmin' || ''"
#   Google or OIDC (claims):      "email == 'you@example.com' && 'GrafanaAdmin' || ''"
# GRAFANA_ROLE_ATTRIBUTE_PATH=
# GitHub: an OAuth app with callback https://<GRAFANA_DOMAIN>/login/github.
# GRAFANA_GITHUB_ENABLED=false
# GRAFANA_GITHUB_CLIENT_ID=
# GRAFANA_GITHUB_CLIENT_SECRET=
# GRAFANA_GITHUB_AUTO_LOGIN=false
# Google: callback https://<GRAFANA_DOMAIN>/login/google.
# GRAFANA_GOOGLE_ENABLED=false
# GRAFANA_GOOGLE_CLIENT_ID=
# GRAFANA_GOOGLE_CLIENT_SECRET=
# Any OpenID Connect provider: callback https://<GRAFANA_DOMAIN>/login/generic_oauth.
# GRAFANA_OIDC_ENABLED=false
# GRAFANA_OIDC_NAME=OpenID Connect
# GRAFANA_OIDC_CLIENT_ID=
# GRAFANA_OIDC_CLIENT_SECRET=
# GRAFANA_OIDC_AUTH_URL=
# GRAFANA_OIDC_TOKEN_URL=
# GRAFANA_OIDC_API_URL=
# GRAFANA_OIDC_SCOPES=openid email profile
# Once a provider works, the admin form can be turned off; the admin then
# signs in only from inside the host.
# GRAFANA_DISABLE_LOGIN_FORM=false

# Where alerts go: none (Grafana only), telegram, slack, email or webhook.
# ALERT_CHANNEL=none
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SLACK_WEBHOOK_URL=
# ALERT_WEBHOOK_URL=
# Email: comma-separated recipients, sent through this SMTP server.
# ALERT_EMAIL_TO=
# GF_SMTP_ENABLED=true
# GF_SMTP_HOST=smtp.example.com:587
# GF_SMTP_USER=
# GF_SMTP_PASSWORD=
# GF_SMTP_FROM_ADDRESS=grafana@example.com

# HTTPS probes from this host, as a JSON list. The "Backend down" alert
# watches the names relay and app.
# PROBE_TARGETS='[{"name":"relay","address":"https://relay.example.com/healthz"},{"name":"app","address":"https://app.example.com/healthz"}]'

# The observability scripts find the base compose file on their own
# (docker-compose.yml, else docker-compose.prod.yml). To override, set
# COMPOSE_BASE in your shell, not here: the scripts don't read it from this
# file.
