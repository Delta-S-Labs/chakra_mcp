# Paste your three keys + the Swiggy MCP URL/token below, then
# `cp .env.example .env` and fill them in. Never commit .env — it's
# gitignored.

# OpenAI — the agent's reasoning model.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Model the agent runs on. Defaults to gpt-5-mini if unset.
OPENAI_MODEL=gpt-5-mini

# Sarvam — speech-to-text + text-to-speech (bulbul:v3).
# https://sarvam.ai → Dashboard → API keys
SARVAM_API_KEY=

# Swiggy Dineout MCP. Swiggy uses OAuth 2.1 (PKCE) — there is NO static
# token to paste. The agent runs the browser login itself at startup
# (first run opens a tab; the ~5-day token is then cached locally per
# persona). You only set the URL here. Leave it blank to run the demo
# without Swiggy (the agent will just suggest a restaurant verbally).
# https://mcp.swiggy.com/builders/docs/start/authenticate/
SWIGGY_MCP_URL=https://mcp.swiggy.com/dineout/mcp

# ChakraMCP relay — these defaults are correct for the hosted network;
# only override for self-host.
CHAKRAMCP_MCP_URL=https://relay.chakramcp.com/mcp

# Voice. Model is bulbul:v3. The TTS speaker is set PER PERSONA in
# personas/<name>.json ("voice_speaker": manan for kaustav, ritu for
# aparajita) and overrides SARVAM_SPEAKER below. SARVAM_SPEAKER is only a
# fallback for personas that don't specify one.
# https://docs.sarvam.ai/api-reference-docs/text-to-speech/convert
SARVAM_MODEL=bulbul:v3
SARVAM_SPEAKER=manan
SARVAM_LANG=en-IN
