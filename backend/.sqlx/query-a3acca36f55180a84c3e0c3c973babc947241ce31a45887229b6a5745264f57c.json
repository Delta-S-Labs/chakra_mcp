{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT k.id as key_id, u.id as user_id, u.email, u.is_admin\n        FROM api_keys k\n        JOIN users u ON u.id = k.user_id\n        WHERE k.key_hash = $1\n          AND k.revoked_at IS NULL\n          AND (k.expires_at IS NULL OR k.expires_at > now())\n        LIMIT 1\n        ",
