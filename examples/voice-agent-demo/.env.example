# `cp .env.example .env` and fill it in. Never commit .env — gitignored.
#
# You need TWO keys to run the demo:
#   1. an LLM key — OpenAI *or* Groq, per LLM_PROVIDER below
#   2. a Sarvam key — for speech-to-text + text-to-speech
# Swiggy needs no key (browser OAuth at startup); the relay uses your
# `chakramcp login` session. Everything else has working defaults.

# LLM provider for the agent's reasoning: "openai" (default), "groq",
# or "openrouter".
LLM_PROVIDER=openai

# Agent loop limits per spoken message (optional; sensible defaults).
# Raise these for slow reasoning models that hit "took too long" /
# MaxTurnsExceeded mid-flow.
#   AGENT_TURN_TIMEOUT_S — wall-clock ceiling per turn (default 300)
#   AGENT_MAX_TURNS      — max LLM+tool loop iterations per turn (default 24)
AGENT_TURN_TIMEOUT_S=300
AGENT_MAX_TURNS=24

# OpenAI (used when LLM_PROVIDER=openai).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Model the agent runs on. Defaults to gpt-5-mini if unset.
OPENAI_MODEL=gpt-5-mini

# Groq (used when LLM_PROVIDER=groq). Groq is OpenAI-API-compatible.
# https://console.groq.com/keys
GROQ_API_KEY=
# Defaults to llama-3.3-70b-versatile if unset.
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (used when LLM_PROVIDER=openrouter). OpenAI-API-compatible
# gateway to many models. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Defaults to nvidia/nemotron-3-super-120b-a12b:free if unset.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Sarvam — speech-to-text + text-to-speech (bulbul:v3).
# https://sarvam.ai → Dashboard → API keys
SARVAM_API_KEY=

# Swiggy Dineout MCP. Swiggy uses OAuth 2.1 (PKCE) — there is NO static
# token to paste. The agent runs the browser login itself at startup
# (first run opens a tab; the ~5-day token is then cached locally per
# persona). You only set the URL here. Leave it blank to run the demo
# without Swiggy (the agent will just suggest a restaurant verbally).
# https://mcp.swiggy.com/builders/docs/start/authenticate/
SWIGGY_MCP_URL=https://mcp.swiggy.com/dineout/mcp

# ChakraMCP relay — these defaults are correct for the hosted network;
# only override for self-host.
CHAKRAMCP_MCP_URL=https://relay.chakramcp.com/mcp

# Voice. Model is bulbul:v3. The TTS speaker is set PER PERSONA in
# personas/<name>.json ("voice_speaker": manan for kaustav, ritu for
# aparajita) and overrides SARVAM_SPEAKER below. SARVAM_SPEAKER is only a
# fallback for personas that don't specify one.
# https://docs.sarvam.ai/api-reference-docs/text-to-speech/convert
SARVAM_MODEL=bulbul:v3
SARVAM_SPEAKER=manan
SARVAM_LANG=en-IN
