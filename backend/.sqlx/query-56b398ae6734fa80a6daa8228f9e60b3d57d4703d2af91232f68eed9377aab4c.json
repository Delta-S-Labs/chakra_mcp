{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT a.id, a.account_id, a.mode\n          FROM agents a\n          JOIN account_memberships m ON m.account_id = a.account_id AND m.user_id = $1\n         WHERE a.tombstoned_at IS NULL\n         ORDER BY a.created_at, a.id\n        ",
