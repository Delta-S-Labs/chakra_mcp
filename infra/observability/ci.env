# Dummy values for the settings a self-hoster must provide — used by the
# observability CI (config checks + smoke test) and for local runs
# (compose.dev.yml). None of these are real; production's live in
# /opt/chakramcp/.env on the VM.
# main's build, rather than the default :latest (the newest release).
CHAKRAMCP_IMAGE=ghcr.io/delta-s-labs/chakramcp-server:edge
POSTGRES_PASSWORD=ci-only-postgres
JWT_SECRET=ci-only-jwt
ADMIN_EMAIL=admin@example.com
APP_PUBLIC_URL=http://localhost:8080
RELAY_PUBLIC_URL=http://localhost:8090
APP_DOMAIN=app.chakramcp.test
RELAY_DOMAIN=relay.chakramcp.test
PG_MONITOR_PASSWORD=ci-only-monitor
GRAFANA_ADMIN_PASSWORD=ci-only-admin
ALERT_CHANNEL=none
PROBE_TARGETS=[]
# Rules load and evaluate but never try to notify.
GF_UNIFIED_ALERTING_EXECUTE_ALERTS=false
