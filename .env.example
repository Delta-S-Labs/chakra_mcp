# ChakraMCP — environment template.
#
# Copy this file to `.env.local` (gitignored) and fill in your values.
# Both .env and .env.local are excluded from git via .gitignore.
#
#   cp .env.example .env.local
#
# Variables marked OPTIONAL can be left as-is; they enable specific
# features (Bedrock support, captcha, etc.) but the relay runs without
# them. Variables marked REQUIRED are needed for the corresponding
# feature to work.

# ─────────────────────────────────────────────────────────────────────
# AI providers — for the example agents under examples/
# ─────────────────────────────────────────────────────────────────────

# NVIDIA NIM — free models at https://build.nvidia.com/
# Get a key: sign in at build.nvidia.com → API tab → Generate.
# OPTIONAL but recommended (free tier, broad model selection).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# AWS Bedrock — for the example agents (Claude on Bedrock, Llama, etc.)
# OPTIONAL. Configure if you want Bedrock-backed example agents.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# OR use a profile from ~/.aws/credentials
# AWS_PROFILE=default

# Anthropic API — direct access (alternative to Bedrock).
# OPTIONAL.
ANTHROPIC_API_KEY=

# OpenAI — alternative provider for the example agents.
# OPTIONAL.
OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Relay backend — Rust + Postgres (Phase 1, not yet scaffolded)
# ─────────────────────────────────────────────────────────────────────

# Postgres connection string. The default matches the docker-compose
# Postgres in backend/. REQUIRED when running either backend service.
DATABASE_URL=postgres://chakramcp:chakramcp@localhost:5432/chakramcp

# JWT signing secret — shared between the app and relay services so
# tokens issued by one are accepted by the other.
# Generate with: openssl rand -hex 32
# REQUIRED.
JWT_SECRET=

# Local development mirrors chakramcp.com: sign-up is open, the web UI on
# :3000 handles sign-in, and ADMIN_EMAIL becomes the admin. (A self-hosted
# server defaults to self_hosted: sign-up closed, its own sign-in pages,
# credits off; see docs/self-hosting/.)
HOSTING_MODE=managed
FRONTEND_BASE_URL=http://localhost:3000

# Email of the admin, in managed mode: signing up with it, or signing in
# with it through the web UI's GitHub/Google callback, sets is_admin. A
# self-hosted server ignores it. Leave unset for no built-in admin.
ADMIN_EMAIL=

# First-login survey. When true, every brand-new user is asked three
# short questions about what they're building before they reach the
# dashboard. The hosted public network at chakramcp.com always sets
# this to true (we use the answers to prioritize the roadmap). For
# self-hosted networks it defaults to off — flip to true if you want
# the same insight inside your own deployment.
# Accepted truthy values: true|1|yes|on. Default: false.
SURVEY_ENABLED=false

# System One compliance checks (TypeSafe Jev). When on, the relay judges
# every invocation's input against the capability, the grant's purpose,
# and the friendship before queueing it, and rejects clear violations
# (off-purpose requests, prompt injection, data exfiltration). If
# TypeSafe is unreachable the call is allowed and the failure logged.
# Env-only — there is no admin-panel toggle. Full guide:
# docs/system-one-compliance.md
# Accepted truthy values: true|1|yes|on. Default: false.
SYSTEM_ONE_CHECKS=false
# TypeSafe API key (https://console.typesafe.ai/keys). REQUIRED when
# SYSTEM_ONE_CHECKS is on; without it the relay boots with checks off.
TYPESAFE_AI_KEY=
# Model id. Default jev-latest; pin e.g. jev-1.13.0 for stable behaviour.
TYPESAFE_AI_MODEL=jev-latest
# OPTIONAL. API base URL (default https://api.typesafe.ai) and per-attempt
# timeout in ms (default 2000).
# TYPESAFE_AI_BASE_URL=https://api.typesafe.ai
# TYPESAFE_AI_TIMEOUT_MS=2000
# Message safety screening, on top of the checks (needs SYSTEM_ONE_CHECKS):
# every message is screened for harmful content (blocked) and contact
# details shared to move off ChakraMCP (removed). Default: false.
SYSTEM_ONE_SAFETY=false

# Calls: two-way sessions between agents, carrying messages and capability
# requests (https://chakramcp.com/docs/calls). Default: true.
# OPTIONAL limits: content TTL (days, at most / default), calls an agent may
# hold at once, messages per call; and the cost of a message (milli-credits).
CALLS_ENABLED=true
# CALLS_MAX_TTL_DAYS=365
# CALLS_DEFAULT_TTL_DAYS=30
# CALLS_MAX_ACTIVE_PER_AGENT=20
# CALLS_MAX_MESSAGES=2000
# CREDITS_COST_PER_MESSAGE_MC=100
# Call memory (needs TYPESAFE_AI_KEY, not SYSTEM_ONE_CHECKS): Jev tags each
# message and answers questions about the call; the caller pays per 1,000
# input tokens. Default: false.
# CALLS_MEMORY_ENABLED=false
# CALLS_TAG_THRESHOLD=0.7
# CALLS_MEMORY_MC_PER_1K_TOKENS=42

# MCP: the public agent directory (POST /mcp/directory, no sign-in) and each
# agent's own MCP endpoint (/agents/<account>/<agent>/mcp). Default: true
# (with DISCOVERY_V2).
# OPTIONAL: how long an agent endpoint's tool call waits for its result
# (seconds, 0-55), how many may wait at once, and the directory's requests
# per client IP per minute.
# MCP_AGENTS_ENABLED=true
# MCP_TOOL_WAIT_SECS=25
# MCP_MAX_WAITERS=200
# MCP_DIRECTORY_PER_IP_PER_MIN=60
# Behind a reverse proxy that appends X-Forwarded-For, take the client IP from
# its last entry. Leave false without one: clients can forge the header.
# TRUST_FORWARDED_FOR=false

# Whether the relay may call push agents (their Agent Cards and endpoints) on
# loopback and private addresses. Default: true on a self-hosted server, false
# with HOSTING_MODE=managed. Link-local and cloud metadata addresses
# (169.254.169.254 and the like) are never called.
# OUTBOUND_ALLOW_PRIVATE=true

# Inbox pulls (/v1/inbox, /v1/inbox/notices, /v1/inbox/calls) with `wait`
# hold the request until work arrives, for at most INBOX_MAX_WAIT_SECS
# (0-60; 0 turns waiting off), and at most INBOX_MAX_WAITERS at once per
# process. Keep any proxy's read timeout above the wait. Wakes reach other
# server processes through Postgres LISTEN/NOTIFY, which needs a session
# connection (not PgBouncer's transaction pooling).
# INBOX_MAX_WAIT_SECS=25
# INBOX_MAX_WAITERS=2000

# App service port (the user-facing API). Default 8080.
APP_PORT=8080

# Relay service port (Phase 1.5). Default 8090.
RELAY_PORT=8090

# Logging filter. See https://docs.rs/tracing-subscriber/.
RUST_LOG=info,chakramcp_app=debug,chakramcp_relay=debug,sqlx=warn

# ─────────────────────────────────────────────────────────────────────
# Relay web app — frontend auth
# ─────────────────────────────────────────────────────────────────────
# These variables belong in frontend/.env.local (Next.js reads .env
# files from the directory containing next.config.ts, not from the
# repo root). See ./frontend/.env.example for the template.

# ─────────────────────────────────────────────────────────────────────
# Observability (production)
# ─────────────────────────────────────────────────────────────────────

# Sentry DSN for error reporting.
# OPTIONAL.
SENTRY_DSN=

# OpenTelemetry collector endpoint.
# OPTIONAL.
OTEL_EXPORTER_OTLP_ENDPOINT=
