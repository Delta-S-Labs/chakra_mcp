    {
      "type": "timeseries",
      "title": "Calls per day",
      "description": "Invocations each day: to the house agents (Ping and the Guide), and to everyone else.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH house AS (SELECT coalesce(array_agg(a.id), '{}') AS ids FROM agents a JOIN accounts acc ON acc.id = a.account_id WHERE acc.slug = 'chakramcp') SELECT $__timeGroupAlias(i.created_at, '1d'), count(*) FILTER (WHERE i.granter_agent_id = ANY (house.ids)) AS \"To house agents\", count(*) FILTER (WHERE NOT coalesce(i.granter_agent_id = ANY (house.ids), false)) AS \"To other agents\" FROM relay_invocations i, house WHERE $__timeFilter(i.created_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
