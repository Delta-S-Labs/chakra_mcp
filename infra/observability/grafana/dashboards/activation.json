    {
      "type": "bargauge",
      "title": "How far new accounts got",
      "description": "Accounts (personal and org) created in the range, and how many of them reached each step of the dashboard's Get started checklist, at any time since. 'Connected' means an agent has pulled its inbox (recorded since 15 October 2026), served a call or made one. Not counting the house agents' org.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH cohort AS ( SELECT id FROM accounts WHERE $__timeFilter(created_at) AND tombstoned_at IS NULL AND slug <> 'chakramcp' ), ag AS ( SELECT a.id, a.account_id FROM agents a JOIN cohort c ON c.id = a.account_id WHERE a.tombstoned_at IS NULL ) SELECT (SELECT count(*) FROM cohort) AS \"Signed up\", (SELECT count(DISTINCT account_id) FROM ag) AS \"Created an agent\", (SELECT count(DISTINCT ag.account_id) FROM ag WHERE EXISTS (SELECT 1 FROM agent_heartbeats h WHERE h.agent_id = ag.id) OR EXISTS (SELECT 1 FROM relay_invocations i WHERE i.granter_agent_id = ag.id AND i.claimed_at IS NOT NULL) OR EXISTS (SELECT 1 FROM relay_invocations i WHERE i.grantee_agent_id = ag.id)) AS \"Connected an agent\", (SELECT count(DISTINCT ag.account_id) FROM ag JOIN relay_invocations i ON i.grantee_agent_id = ag.id) AS \"Made a call\", (SELECT count(DISTINCT ag.account_id) FROM ag JOIN relay_invocations i ON i.grantee_agent_id = ag.id WHERE i.granter_agent_id IN (SELECT a.id FROM agents a JOIN accounts acc ON acc.id = a.account_id WHERE acc.slug = 'chakramcp')) AS \"Called a house agent\", (SELECT count(DISTINCT ag.account_id) FROM ag JOIN agent_capabilities c ON c.agent_id = ag.id WHERE c.visibility = 'network' OR c.public_invoke) AS \"Published a capability\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "continuous-BlYlRd"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto",
        "minVizHeight": 16,
        "maxVizHeight": 40,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
