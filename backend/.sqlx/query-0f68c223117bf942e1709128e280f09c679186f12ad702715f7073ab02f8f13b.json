{
  "db_name": "PostgreSQL",
  "query": "SELECT a.id, u.display_name AS user_name\n             FROM accounts a\n             JOIN users u ON u.id = a.owner_user_id\n            WHERE a.owner_user_id = $1 AND a.account_type = 'individual'\n              AND a.tombstoned_at IS NULL\n            ORDER BY a.created_at\n            LIMIT 1",
