  "db_name": "PostgreSQL",
  "query": "\n        SELECT c.id, c.agent_id, c.name, c.description, ga.account_id as granter_account_id\n        FROM agent_capabilities c\n        JOIN agents ga ON ga.id = c.agent_id\n        WHERE c.id = $1 AND ga.tombstoned_at IS NULL\n        ",
