    {
      "type": "stat",
      "title": "Last inbox poll",
      "description": "Seconds since a house agent last pulled its inbox (they poll every 5 s when idle). Ignores the time range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT EXTRACT(EPOCH FROM now() - max(h.last_polled_at)) AS \"Last poll\" FROM agent_heartbeats h JOIN agents a ON a.id = h.agent_id JOIN accounts acc ON acc.id = a.account_id WHERE acc.slug = 'chakramcp' AND a.tombstoned_at IS NULL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "0",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          }
        },
        "overrides": []
      },
