          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS \"Started\", amount_cents / 100.0 AS \"Amount\", unapplied_reason AS \"Reason\", account_id AS \"Account\", id AS \"Checkout\" FROM credit_checkouts WHERE status = 'unapplied' ORDER BY created_at DESC LIMIT 50"
