    {
      "type": "table",
      "title": "Recent purchases",
      "description": "The latest 50 paid purchases in the selected time range. Look an account up by its id in the admin console.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT paid_at AS \"Paid\", amount_cents / 100.0 AS \"Amount\", credits_mc / 1000.0 AS \"Credits\", account_id AS \"Account\", id AS \"Checkout\" FROM credit_checkouts WHERE status = 'paid' AND $__timeFilter(paid_at) ORDER BY paid_at DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "None"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Amount"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
