# Minimal-context image build: assumes the chakramcp-server binary
# was already cross-compiled to backend/target/x86_64-unknown-linux-gnu/release/
# via `cargo zigbuild --target x86_64-unknown-linux-gnu --release`.
#
# Why a separate Dockerfile: the compile-inside-buildx approach OOMs the
# colima VM under QEMU emulation. Native arm64→x86_64 compile via zig is
# faster, doesn't need the 8GB QEMU overhead, and produces the same binary.
#
# Build context = repo root. Make sure the binary exists at infra/chakramcp-server:
#     cd backend && cargo zigbuild --target x86_64-unknown-linux-gnu --release --bin chakramcp-server
#     cp backend/target/x86_64-unknown-linux-gnu/release/chakramcp-server infra/chakramcp-server
#     docker buildx build --platform linux/amd64 -f infra/Dockerfile.thin --push -t <REGISTRY>/chakramcp-server:latest .

FROM --platform=linux/amd64 debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates libssl3 wget \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --shell /usr/sbin/nologin chakra

COPY infra/chakramcp-server /usr/local/bin/chakramcp-server

USER chakra
WORKDIR /home/chakra

# 8080 = chakramcp-app, 8090 = chakramcp-relay.
EXPOSE 8080 8090

HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=4 \
    CMD wget -qO- http://127.0.0.1:8090/healthz || exit 1

ENTRYPOINT ["/usr/local/bin/chakramcp-server"]
CMD ["start"]
