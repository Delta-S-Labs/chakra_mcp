{
  "name": "chakramcp-house-agents",
  "version": "0.1.0",
  "private": true,
  "description": "chakramcp.com's house agents: Ping and the ChakraMCP Guide (Claude). Not for self-hosted servers.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bundle-docs": "node scripts/bundle-docs.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/bundle-docs.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "test": "tsc -p tsconfig.json && node --disable-warning=ExperimentalWarning --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@chakramcp/sdk": "0.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
