{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT a.id, a.slug, a.account_id, acc.slug AS account_slug\n        FROM agents a\n        JOIN accounts acc ON acc.id = a.account_id\n        WHERE a.id = $1 AND a.tombstoned_at IS NULL\n        FOR UPDATE OF a\n        ",
