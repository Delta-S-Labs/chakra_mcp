    {
      "type": "barchart",
      "title": "Revenue by month",
      "description": "The last 12 calendar months (UTC), whatever the selected time range. List price, before tax: Dodo's dashboard has tax, fees, refunds and payouts.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(m, 'YYYY-MM') AS \"Month\", COALESCE((SELECT SUM(c.amount_cents) FROM credit_checkouts c WHERE c.status = 'paid' AND c.paid_at >= m AND c.paid_at < m + interval '1 month'), 0) / 100.0 AS \"Revenue\" FROM generate_series(date_trunc('month', now() - interval '11 months', 'UTC'), date_trunc('month', now(), 'UTC'), interval '1 month') AS m ORDER BY m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
