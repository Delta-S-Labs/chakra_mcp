  "query": "\n        SELECT id, grantee_agent_id FROM grants\n         WHERE granter_agent_id = $1 AND capability_id = $2\n           AND grantee_agent_id = ANY($3)\n           AND status = 'active' AND (expires_at IS NULL OR expires_at > now())\n         ORDER BY granted_at, id\n         LIMIT 1\n        ",
