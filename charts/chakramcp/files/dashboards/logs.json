{
  "uid": "chakramcp-logs",
  "title": "ChakraMCP — Logs",
  "description": "Every container's logs (14 days). Pick services, search with a regex.",
  "tags": [
    "chakramcp"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "service",
        "label": "Service",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "query": "relay,caddy,pg,redis,migrate,alloy,loki,prometheus,grafana,kernel",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "selected": false,
            "text": "relay",
            "value": "relay"
          },
          {
            "selected": false,
            "text": "caddy",
            "value": "caddy"
          },
          {
            "selected": false,
            "text": "pg",
            "value": "pg"
          },
          {
            "selected": false,
            "text": "redis",
            "value": "redis"
          },
          {
            "selected": false,
            "text": "migrate",
            "value": "migrate"
          },
          {
            "selected": false,
            "text": "alloy",
            "value": "alloy"
          },
          {
            "selected": false,
            "text": "loki",
            "value": "loki"
          },
          {
            "selected": false,
            "text": "prometheus",
            "value": "prometheus"
          },
          {
            "selected": false,
            "text": "grafana",
            "value": "grafana"
          },
          {
            "selected": false,
            "text": "kernel",
            "value": "kernel"
          }
        ]
      },
      {
        "type": "textbox",
        "name": "search",
        "label": "Search (regex)",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "ChakraMCP dashboards",
      "type": "dashboards",
      "tags": [
        "chakramcp"
      ],
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "Log lines by service",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "legendFormat": "{{service}}",
          "expr": "sum by (service) (count_over_time({service=~\"$service\"} |~ \"(?i)$search\" [$__auto]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "drawStyle": "bars"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Errors and warnings",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "legendFormat": "{{service}} {{level}}",
          "expr": "sum by (service, level) (count_over_time({service=~\"$service\", level=~\"error|warn\"} |~ \"(?i)$search\" [$__auto]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "drawStyle": "bars"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "type": "logs",
      "title": "Logs",
      "description": "JSON lines (relay, Caddy) carry request_id, method and route: click a line for its fields.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=~\"$service\"} |~ \"(?i)$search\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      },
      "id": 3,
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 7
      }
    }
  ]
}
