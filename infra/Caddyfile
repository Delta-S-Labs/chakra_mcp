# Caddy auto-provisions Let's Encrypt certificates for every site below.
# The hostnames come from the environment (docker-compose.prod.yml, from
# .env): APP_DOMAIN → the app API (:8080), RELAY_DOMAIN → the relay (:8090),
# GRAFANA_DOMAIN → Grafana (infra/observability/; `localhost` unless set).
# The OAuth flow needs both the app and the relay reachable.

{
	# For testing, avoid Let's Encrypt's rate limits with:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

	# The local CA (the `localhost` Grafana default) stays inside the
	# container.
	skip_install_trust

	# Prometheus metrics per host (unknown hosts are grouped as "_other"),
	# served on the internal :2020 site below for the observability stack.
	metrics {
		per_host
	}
}

{$RELAY_DOMAIN} {
	encode zstd gzip
	# Forward client IP for the relay's rate-limit / audit log.
	reverse_proxy relay:8090 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
	# Hide upstream errors behind a generic message.
	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}

{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy relay:8080 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}

# Grafana (infra/observability/). Password (Basic) auth is refused from
# outside: people sign in through the login form or a provider, which use a
# cookie. Grafana's own /metrics is for the collector, not the internet.
{$GRAFANA_DOMAIN} {
	encode zstd gzip
	@basic header_regexp Authorization (?i)^basic[[:space:]]
	respond @basic 403
	respond /metrics 404
	reverse_proxy grafana:3000
	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}

# Caddy's own metrics for the collector. Internal only: this port isn't
# published, so it's reachable just from the Docker networks.
:2020 {
	metrics
}

# Catch-all for unknown hosts so we don't auto-issue certs for
# random visitors hitting the IP. Returns 421 Misdirected Request.
:80 {
	respond 421
}
