# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Generated by scripts/sync-skills.mjs from .claude/skills/.
# Single source of truth lives in .claude/skills/<name>/SKILL.md.
/public/skills/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# but DO commit the templates
!.env.example

# vercel
.vercel

# Netlify edge-function build artifact (Netlify's adapter uses Deno
# under the hood and drops this lockfile during build/dev). The
# `.netlify/` build output is already ignored via root .gitignore;
# this catches the top-level lockfile sibling it spits out too.
deno.lock

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright e2e run artefacts (screenshots, traces, videos, html-report).
# The spec + config + helpers are tracked; the per-run output dirs aren't.
/e2e/screenshots/
