  "query": "\n        SELECT (charged_at AT TIME ZONE 'UTC')::date AS \"day!\",\n               count(*) AS \"invocations!\",\n               SUM(cost_mc)::bigint AS \"spent_mc!\"\n          FROM invocation_charges\n         WHERE account_id = $1 AND charged_at >= now() - interval '30 days'\n         GROUP BY 1 ORDER BY 1\n        ",
