  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, agent_id, name, description, input_schema, output_schema,\n               visibility, created_at, updated_at,\n               public_invoke, public_monthly_quota_per_agent, semantics,\n               consent_required, consent_approvers, consent_max_validity_secs,\n               consent_wait_secs\n        FROM agent_capabilities\n        WHERE agent_id = $1\n          AND (\n              $2::boolean\n              OR visibility = 'network'\n              OR ($3::boolean AND visibility = 'org')\n          )\n        ORDER BY name ASC\n        ",
