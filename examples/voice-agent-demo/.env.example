# Paste your three keys + the Swiggy MCP URL/token below, then
# `cp .env.example .env` and fill them in. Never commit .env — it's
# gitignored.

# OpenAI — GPT-4o is the agent's reasoning model.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Sarvam — speech-to-text + text-to-speech (bulbul:v3).
# https://sarvam.ai → Dashboard → API keys
SARVAM_API_KEY=

# Swiggy Dineout MCP — auth token from the builder flow.
# https://mcp.swiggy.com/builders/docs/start/authenticate/
SWIGGY_MCP_URL=https://mcp.swiggy.com/dineout/mcp
SWIGGY_MCP_TOKEN=

# ChakraMCP relay — these defaults are correct for the hosted network;
# only override for self-host.
CHAKRAMCP_MCP_URL=https://relay.chakramcp.com/mcp

# Optional voice tuning. `bulbul:v3` speakers: shubh, aditya, ritu, anushka, etc.
# https://docs.sarvam.ai/api-reference-docs/text-to-speech/convert
SARVAM_SPEAKER=shubh
SARVAM_LANG=en-IN
