  "query": "\n            SELECT last_sent_at AS \"last_sent_at!\",\n                   EXTRACT(EPOCH FROM (last_sent_at + $2::float8 * interval '1 second' - now()))\n                       ::float8 AS \"left!\"\n              FROM agent_wake\n             WHERE agent_id = $1 AND enabled AND last_sent_at IS NOT NULL\n            ",
