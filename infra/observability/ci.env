# Dummy values for everything the prod compose files interpolate — used by
# the observability CI (config checks + smoke test) and for local runs
# (compose.dev.yml). None of these are real; the real ones live in
# /opt/chakramcp/.env on the VM.
CHAKRAMCP_IMAGE=chakramcp-server:ci-only
POSTGRES_PASSWORD=ci-only-postgres
JWT_SECRET=ci-only-jwt
WEBHOOK_SIGNING_SECRET=ci-only-webhook
ADMIN_EMAIL=admin@example.com
APP_PUBLIC_URL=http://localhost:8080
RELAY_PUBLIC_URL=http://localhost:8090
PG_MONITOR_PASSWORD=ci-only-monitor
GRAFANA_ADMIN_PASSWORD=ci-only-admin
GRAFANA_GITHUB_CLIENT_ID=ci-only-client-id
GRAFANA_GITHUB_CLIENT_SECRET=ci-only-client-secret
GRAFANA_ROLE_ATTRIBUTE_PATH="login == 'ci-only' && 'GrafanaAdmin' || ''"
TELEGRAM_BOT_TOKEN=ci-only-bot-token
TELEGRAM_CHAT_ID=0
# Rules load and evaluate but never try to notify.
GF_UNIFIED_ALERTING_EXECUTE_ALERTS=false
