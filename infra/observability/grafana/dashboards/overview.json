{
  "uid": "chakramcp-overview",
  "title": "ChakraMCP — Overview",
  "description": "The backend at a glance: traffic, errors, latency, invocations, limits, credits.",
  "tags": [
    "chakramcp"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Deploys and restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "#5794F2",
        "expr": "chakramcp_build_info * on (instance, job) group_left changes(process_start_time_seconds{job=\"chakramcp\"}[2m]) > 0",
        "step": "60s",
        "titleFormat": "relay restarted",
        "textFormat": "build {{git_sha}}"
      }
    ]
  },
  "links": [
    {
      "title": "ChakraMCP dashboards",
      "type": "dashboards",
      "tags": [
        "chakramcp"
      ],
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Service health",
