  "query": "\n        SELECT id, amount_cents, credits_mc, created_at, paid_at,\n               CASE WHEN status = 'open' AND created_at < now() - interval '24 hours'\n                    THEN 'expired' ELSE status END AS \"status!\"\n          FROM credit_checkouts WHERE id = $1 AND account_id = $2\n        ",
