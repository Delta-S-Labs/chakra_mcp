    {
      "type": "stat",
      "title": "Guide spend",
      "description": "Claude spend on Guide questions in the last 24 hours, failed attempts included. The service stops answering at HOUSE_DAILY_BUDGET_USD (default $10).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(sum_over_time({service=\"house-agents\"} | json | msg=\"guide.answered\" | unwrap cost_usd | __error__=\"\" [24h]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "noValue": "0",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 8
              },
              {
                "color": "red",
                "value": 10
