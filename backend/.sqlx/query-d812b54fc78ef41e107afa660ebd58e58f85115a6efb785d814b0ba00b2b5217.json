{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT a.id, a.slug, acc.slug AS account_slug\n          FROM agents a\n          JOIN accounts acc ON acc.id = a.account_id\n          JOIN account_memberships m ON m.account_id = a.account_id AND m.user_id = $1\n         WHERE a.tombstoned_at IS NULL\n        ",
