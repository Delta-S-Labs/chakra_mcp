    {
      "type": "timeseries",
      "title": "Credits added and spent per day",
      "description": "Per UTC day: credits added by purchases, monthly free grants and the operator (above the line), and credits spent on invocations (below it).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1d', 0), COALESCE(SUM(delta_mc) FILTER (WHERE reason = 'purchase'), 0) / 1000.0 AS \"Bought\", COALESCE(SUM(delta_mc) FILTER (WHERE reason = 'free_grant'), 0) / 1000.0 AS \"Free grants\", COALESCE(SUM(delta_mc) FILTER (WHERE reason IN ('admin_grant', 'adjustment')), 0) / 1000.0 AS \"Operator grants and adjustments\" FROM credit_ledger WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(charged_at, '1d', 0), SUM(cost_mc) / 1000.0 AS \"Spent\" FROM invocation_charges WHERE $__timeFilter(charged_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "barAlignment": 0,
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Spent"
            },
            "properties": [
              {
                "id": "custom.transform",
                "value": "negative-Y"
              },
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "normal",
                  "group": "B"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
