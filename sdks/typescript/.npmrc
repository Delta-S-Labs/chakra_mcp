# `packageManager` in package.json pins pnpm (so Dependabot, CI and Netlify
# all generate the lockfile with the same pnpm, keeping `pnpm.overrides`).
# Only warn, don't fail, when a local pnpm differs: pnpm < 9.2 otherwise
# refuses to run at all. pnpm >= 9.2 already only checks the name.
package-manager-strict=false
