    {
      "type": "stat",
      "title": "Checkouts by outcome",
      "description": "Checkouts started in the selected time range, by where they ended up. Declined: the card failed and nothing was paid. Abandoned: still open after 24 hours. Needs review: paid but not credited (wrong amount or currency, a discount, or the account is gone): refund it in Dodo or grant the credits.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE status = 'paid') AS \"Paid\", count(*) FILTER (WHERE status = 'failed') AS \"Declined\", count(*) FILTER (WHERE status = 'open' AND created_at < now() - interval '24 hours') AS \"Abandoned\", count(*) FILTER (WHERE status = 'open' AND created_at >= now() - interval '24 hours') AS \"In progress\", count(*) FILTER (WHERE status = 'unapplied') AS \"Needs review\" FROM credit_checkouts WHERE $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "noValue": "0",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "id": 13,
      "gridPos": {
        "h": 5,
        "w": 14,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "stat",
      "title": "Conversion",
      "description": "Paid checkouts out of those started in the selected time range, leaving out ones still in progress (open for less than 24 hours).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE status = 'paid')::float / NULLIF(count(*) FILTER (WHERE NOT (status = 'open' AND created_at >= now() - interval '24 hours')), 0) AS \"Conversion\" FROM credit_checkouts WHERE $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "–",
