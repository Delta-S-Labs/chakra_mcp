{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "frontend",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "frontend-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "frontend",
        "start",
        "--port",
        "3100"
      ],
      "port": 3100
    }
  ]
}
