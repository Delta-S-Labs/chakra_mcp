    {
      "type": "stat",
      "title": "Calls that succeeded",
      "description": "Of the calls in the range that finished: succeeded, failed, rejected or timed out.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE status = 'succeeded') / NULLIF(count(*) FILTER (WHERE status IN ('succeeded', 'failed', 'rejected', 'timeout')), 0) AS \"Succeeded\" FROM relay_invocations WHERE $__timeFilter(created_at)"
