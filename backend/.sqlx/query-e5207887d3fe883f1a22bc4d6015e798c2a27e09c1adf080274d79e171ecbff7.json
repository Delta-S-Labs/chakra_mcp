{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            g.id as grant_id, g.status as grant_status,\n            g.granter_agent_id, g.grantee_agent_id, g.capability_id,\n            g.expires_at, g.granted_at, g.purpose as grant_purpose,\n            ga.account_id as granter_account_id,\n            ga.mode as granter_mode,\n            ga.slug as granter_slug,\n            gacc.slug as granter_account_slug,\n            ea.account_id as grantee_account_id,\n            cap.name as capability_name,\n            cap.visibility as capability_visibility,\n            cap.description as capability_description,\n            cap.input_schema as capability_input_schema,\n            cap.consent_required, cap.consent_max_validity_secs, cap.consent_wait_secs,\n            -- Accepted friendship between the two agents, in either\n            -- direction. LEFT JOIN so a missing one surfaces as a\n            -- recorded rejection rather than a bare 404.\n            f.id as \"friendship_id?\",\n            f.status as \"friendship_status?\",\n            f.proposer_agent_id as \"friendship_proposer_agent_id?\",\n            f.target_agent_id as \"friendship_target_agent_id?\",\n            f.proposer_message as \"friendship_proposer_message?\",\n            f.response_message as \"friendship_response_message?\",\n            f.decided_at as \"friendship_decided_at?\"\n        FROM grants g\n        JOIN agents ga ON ga.id = g.granter_agent_id\n        JOIN accounts gacc ON gacc.id = ga.account_id\n        JOIN agents ea ON ea.id = g.grantee_agent_id\n        JOIN agent_capabilities cap ON cap.id = g.capability_id\n        LEFT JOIN friendships f\n            ON f.status = 'accepted'\n            AND (\n                (f.proposer_agent_id = g.granter_agent_id\n                    AND f.target_agent_id = g.grantee_agent_id)\n                OR (f.proposer_agent_id = g.grantee_agent_id\n                    AND f.target_agent_id = g.granter_agent_id)\n            )\n        WHERE g.id = $1\n          -- Deleted agents, or agents of deleted accounts, neither call\n          -- nor get called (their grants are revoked too).\n          AND ga.tombstoned_at IS NULL\n          AND ea.tombstoned_at IS NULL\n          AND NOT EXISTS (\n              SELECT 1 FROM accounts x\n               WHERE x.id IN (ga.account_id, ea.account_id)\n                 AND x.tombstoned_at IS NOT NULL)\n        LIMIT 1\n        ",
