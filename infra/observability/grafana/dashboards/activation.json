    {
      "type": "stat",
      "title": "Agents online now",
      "description": "Agents that pulled their inbox in the last 5 minutes, not counting the house agents. Ignores the time range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Online\" FROM agent_heartbeats h JOIN agents a ON a.id = h.agent_id JOIN accounts acc ON acc.id = a.account_id WHERE h.last_polled_at > now() - interval '5 minutes' AND a.tombstoned_at IS NULL AND acc.slug <> 'chakramcp'"
